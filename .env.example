# Optional: copy to .env. Default provider is locally authenticated Codex CLI.
CODEX_MODEL=
CODEX_TIMEOUT_SECONDS=240
# Optional full path to Codex executable, otherwise discover from PATH.
# CODEX_BIN=
# Only needed for the optional OpenAI API mode:
# OPENAI_API_KEY=

# Hosted web / local worker (keep real values only in your local .env)
# TRADESCOUT_URL=https://your-service.onrender.com
# TRADESCOUT_ACCESS_TOKEN=
# TRADESCOUT_DATA_DIR=
